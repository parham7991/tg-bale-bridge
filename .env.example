ADMIN_BALE_ID=0

# ===== بات مدیریت تلگرام (اختیاری) =====
# برای مدیریت سلف‌بات از طریق یک بات تلگرام (از @BotFather بسازید)
# اگر خالی بماند، این قابلیت غیرفعال است
TG_BOT_TOKEN=
# آیدی عددی شما در تلگرام (برای دستورات مدیریتی بات تلگرام)
# اگر نمی‌دانید: خالی بگذارید، بعد از /start آیدی شما را می‌گوید
ADMIN_TG_ID=0

# ===== تنظیمات اختیاری =====
