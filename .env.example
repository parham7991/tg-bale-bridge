# ══════════════════════════════════════════════════════
#   حداقلِ لازم برای شروع: فقط همین یک خط!
#   بقیه را از داخل بات تلگرام با /setup (ویزارد) ست کنید
# ══════════════════════════════════════════════════════
TG_BOT_TOKEN=

# ──────── همه‌ی موارد زیر «اختیاری»اند (ویزارد خودش ست می‌کند) ─────────

# ── داشبورد وب ──
#DASH_ENABLED=1
#DASH_HOST=0.0.0.0
#DASH_PORT=8080
# یوزرنیم/رمز: از داخل بات /dashboard بگیرید (رمز اولیه یک‌بار نشان داده می‌شود)

# ── بله ──
# توکن ربات بله (از @ble-robot بگیرید)
BALE_TOKEN=
# حالت کار بله: bot = ربات رسمی | user = سلف‌بات (حساب کاربری) با کتابخانه aiobale
# اگر ربات بله را نمی‌توانید در کانال ادمین کنید: BALE_MODE=user بگذارید و یک بار
# اجرا کنید:  python login_bale.py
BALE_MODE=bot
#BALE_SESSION=data/session
#BALE_PHONE=+98912xxxxxxx
# شماره user id شما در بله (برای پنل ادمین — بعد از اولین /start هم خودکار ثبت می‌شود)
#ADMIN_BALE_ID=

# ── تلگرام (سلف‌بات Telethon) ──
TG_API_ID=
TG_API_HASH=
TG_PHONE=

# ── ربات تلگرام مدیریتی (اختیاری ولی پیشنهادی) ──
#TG_BOT_TOKEN=
#TG_BOT_API_BASE=https://api.telegram.org
#ADMIN_TG_ID=

# ── عمومی ──
#DATA_DIR=data
#ALBUM_DELAY=0.9
